{
  "name": "pre-owned-cars-backend",
  "version": "1.0.0",
  "description": "AutoDeal4U - Pre-Owned Cars Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "npx --yes sequelize-cli db:migrate",
    "catalog:seed": "node scripts/seed-car-catalog.js",
    "vercel-build": "npm ci --omit=dev",
    "render-build": "npm install --legacy-peer-deps && npm run db:migrate",
    "postinstall": "npm run db:migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.23.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.8",
    "redis": "^6.1.0",
    "sequelize": "^3.30.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "sequelize": {
      "lodash": "^4.17.24",
      "dottie": "^2.0.4",
      "validator": "^13.15.20"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ]
  }
}
